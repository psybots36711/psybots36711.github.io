  />
  <h1 class="visually-hidden">Psybots 36711</h1>

  <svg
    class="hero__smoke"
    viewBox="0 0 1200 560"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <radialGradient id="smoke-gradient" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#858c9a" stop-opacity="0.55" />
        <stop offset="58%" stop-color="#525c6d" stop-opacity="0.34" />
        <stop offset="100%" stop-color="#525c6d" stop-opacity="0" />
      </radialGradient>
      <filter id="smoke-blur" x="-30%" y="-50%" width="160%" height="200%">
        <feGaussianBlur stdDeviation="22" />
      </filter>
    </defs>
    <g class="smoke">
      <ellipse class="smoke__cloud" cx="600" cy="280" rx="390" ry="138" />
      <ellipse class="smoke__cloud" cx="470" cy="260" rx="250" ry="108" />
      <ellipse class="smoke__cloud" cx="735" cy="310" rx="265" ry="114" />
      <ellipse class="smoke__cloud" cx="585" cy="205" rx="285" ry="100" />
      <ellipse class="smoke__cloud" cx="620" cy="365" rx="305" ry="112" />
    </g>
  </svg>
</section>
