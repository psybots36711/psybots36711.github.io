<style>
  section {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
    background: #24262a;
  }

  .hero__lightning,
  .hero__smoke {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__lightning {
    z-index: 1;
  }

  .hero__smoke {
    z-index: 3;
  }

  @keyframes logo-emerge {
    from {
      opacity: 0;
      filter: blur(24px) drop-shadow(0 0 24px rgb(36 91 255 / 30%));
    }
    to {
      opacity: 1;
      filter: blur(0) drop-shadow(0 0 24px rgb(36 91 255 / 30%));
    }
  }

  .hero__logo {
    position: relative;
    z-index: 2;
    display: block;
    grid-area: 1 / 1;
    width: 448px;
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 0 24px rgb(36 91 255 / 30%));
    animation: logo-emerge 1.7s 0.4s both linear;
  }

  .bolt {
    fill: none;
    stroke: #245bff;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    filter: drop-shadow(0 0 5px #245bff) drop-shadow(0 0 15px #1643d8);
    animation: lightning-burst-one 9s infinite;
  }

  .bolt__glow {
    fill: none;
    stroke: #245bff;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: blur(4px) drop-shadow(0 0 14px #245bff);
  }

  .bolt__core {
    fill: none;
    stroke: #f3f3f3;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 5px #fff) drop-shadow(0 0 12px #245bff);
  }

  .smoke {
    opacity: 0;
    filter: url(#smoke-blur);
    transform-box: fill-box;
    transform-origin: center;
    animation: smoke-clear 1.7s 0.4s both linear;
  }

  .smoke__cloud {
    fill: url(#smoke-gradient);
  }

  @keyframes smoke-clear {
    0%,
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.9);
    }
    25% {
      opacity: 0.4;
      transform: translateY(0) scale(1);
    }
    50% {
      opacity: 0.2;
      transform: translateY(-8px) scale(1.25);
    }
    100% {
      opacity: 0;
      transform: translateY(-16px) scale(1.5);
    }
  }

  .bolt--two {
    animation-name: lightning-burst-two;
  }
  .bolt--three {
    animation-name: lightning-burst-three;
  }

  @keyframes lightning-burst-one {
    0%,
    4%,
    100% {
      opacity: 0;
    }
    0.3% {
      opacity: 1;
    }
    0.65% {
      opacity: 0.2;
    }
    0.95% {
      opacity: 0.85;
    }
    1.25% {
      opacity: 0;
    }
    41% {
      opacity: 0;
    }
    42% {
      opacity: 1;
    }
    43% {
      opacity: 0.2;
    }
    44% {
      opacity: 0.85;
    }
    45% {
      opacity: 0;
    }
  }

  @keyframes lightning-burst-two {
    0%,
    1.5%,
    4%,
    100% {
      opacity: 0;
    }
    1.8% {
      opacity: 1;
    }
    2.15% {
      opacity: 0.2;
    }
    2.45% {
      opacity: 0.85;
    }
    2.75% {
      opacity: 0;
    }
    53.5% {
      opacity: 0;
    }
    54.5% {
      opacity: 1;
    }
    55.5% {
      opacity: 0.2;
    }
    56.5% {
      opacity: 0.85;
    }
    57.5% {
      opacity: 0;
    }
  }

  @keyframes lightning-burst-three {
    0%,
    4%,
    100% {
      opacity: 0;
    }
    3%,
    3.2%,
    4% {
      opacity: 0;
    }
    3.3% {
      opacity: 1;
    }
    3.65% {
      opacity: 0.2;
    }
    3.95% {
      opacity: 0.85;
    }
    4.25% {
      opacity: 0;
    }
    66% {
      opacity: 0;
    }
    67% {
      opacity: 1;
    }
    68% {
      opacity: 0.2;
    }
    69% {
      opacity: 0.85;
    }
    70% {
      opacity: 0;
    }
  }
</style>

<section>
