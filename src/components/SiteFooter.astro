---
const { class: className, ...rest } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["site-footer", className]} {...rest}>
  <div class="footer-inner">
    <span>© {year} Psybots Robotics</span>
    <span>Team 36711</span>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
  }

  @media (max-width: 420px) {
    .footer-inner {
      padding-right: 16px;
      padding-left: 16px;
    }
  }
</style>
