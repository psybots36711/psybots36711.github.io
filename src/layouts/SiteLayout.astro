---
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteCircuit from "@/components/SiteCircuit.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Psybots 36711",
  description = "The Psybots robotics team website.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/avif" href="/psybots-favicon.avif" />
    <title>{title}</title>
  </head>
  <body>
    <SiteNav class="site-nav" />
    <main>
      <slot />
    </main>
    <SiteFooter class="site-footer" />
    <SiteCircuit class="site-circuit" />
  </body>
</html>

<style>
  body {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  main {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
  }

  .site-nav {
    position: relative;
    z-index: 3;
  }

  .site-footer {
    position: relative;
    z-index: 2;
  }

  .site-circuit {
    position: fixed;
    z-index: 0;
  }
</style>
