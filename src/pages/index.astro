---
import HomeHero from "@/components/HomeHero.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The Psybots robotics team website." />
    <meta name="theme-color" content="#10131a" />
    <title>Psybots Robotics</title>
    <style>
      :root {
        font-family: system-ui, sans-serif;
        color: #f3f3f3;
        background: #111214;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
      }
      main {
        min-height: 100vh;
      }

      .hero {
        position: relative;
        isolation: isolate;
        display: grid;
        grid-template-rows: auto auto;
        overflow: hidden;
        background: #111214;
        text-align: center;
      }

      .hero__content {
        position: relative;
        z-index: 2;
        grid-row: 2;
        display: grid;
        align-content: center;
        justify-items: center;
        padding: 3rem 1.5rem;
      }

      .hero__title {
        margin: 1.25rem 0 0;
        font-size: clamp(2.5rem, 8vw, 5rem);
        letter-spacing: -0.06em;
      }

      .hero__copy {
        max-width: 34rem;
        margin: 0.75rem 0 0;
        color: #b8c0cc;
        line-height: 1.6;
      }
      .hero__tag {
        margin: 1.75rem 0 0;
        color: #5b82ff;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <HomeHero />
        <header class="hero__content">
          <h1 class="hero__title" id="hero-title">
            Psybots Robotics
          </h1>
          <p class="hero__copy">
            We’re a robotics team building, learning, and competing together.
          </p>
          <p class="hero__tag">Our new website is under construction</p>
        </header>
      </section>
    </main>
  </body>
</html>
